# ==============================================================================
# Saveo — Environment Variables
# See PRODUCTION.md for full deployment/secrets guidance.
# ==============================================================================

# --- Database (required) ---
# PostgreSQL connection string. In production, use a pooled connection
# string (e.g. Neon's pooled endpoint) to avoid exhausting connections
# under load.
DATABASE_URL="postgresql://user:password@localhost:5432/saveo?schema=public"

# --- Auth.js / NextAuth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Site URL (required for correct SEO metadata, sitemap, and canonical URLs) ---
# Must be the real public URL in production (used to build absolute URLs
# for Open Graph images, sitemap.xml, and robots.txt).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Error Monitoring (optional — inert until set, see src/lib/sentry.ts) ---
# Leave empty to disable Sentry entirely. When set, also run:
#   npm install @sentry/nextjs
#   npx @sentry/wizard@latest -i nextjs
SENTRY_DSN=""

# --- Payment Gateways (optional — see src/lib/services/payment-service.ts) ---
# All payment methods except Cash on Delivery (COD) are unavailable until
# their corresponding variable below is set AND a real provider
# implementation is written (Phase 4.5 deliberately ships the
# architecture only, not a live integration — see PaymentService).
KNET_MERCHANT_ID=""
CARD_GATEWAY_API_KEY=""       # used for generic Card, Visa, and MasterCard provider slots
APPLE_PAY_MERCHANT_ID=""

# --- Email (Phase 5.1 — optional, inert until set, see src/lib/email/provider.ts) ---
# Recommended provider: Resend (npm install resend). Leave empty to
# disable email entirely — every send attempt is still logged to
# EmailLog with status SKIPPED, nothing is silently lost.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Saveo <no-reply@saveo.com.kw>"

# --- Image Uploads (optional) ---
# NOTE: as of this build, no admin/supplier image-upload endpoint exists
# yet — product images are entered as URLs and must resolve from a
# domain listed in next.config.js's images.remotePatterns. This token is
# reserved for when a real upload flow (e.g. UploadThing) is built.
UPLOADTHING_TOKEN=""
