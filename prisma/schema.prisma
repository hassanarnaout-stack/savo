// ---------------------------------------------------------------------------
// COMMERCE ERP — Goods Receiving, Batches, Stock Counting (Phase 5.5)
//
// Everything else requested in this phase already exists from earlier
// work and is deliberately left untouched: cost/barcode as Product
// fields (see purchaseCost/barcode/sku), SupplierLedgerEntry (the
// general ledger), SupplierPayout (the period-based settlement model —
// same shape as the "SupplierSettlement" requested here, just named
// earlier), damaged/expired quantity tracking + recordDamage/recordExpiry
// in inventory.ts, and /admin/finance. See the final delivery report for
// the full audit.
// ---------------------------------------------------------------------------

enum GoodsReceiptStatus {
  PENDING
  RECEIVED
  VERIFIED
  CANCELLED
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  supplierId      String
  referenceNumber String             @unique
  status          GoodsReceiptStatus @default(PENDING)
  receivedByUserId String?
  receivedAt      DateTime?
  createdAt       DateTime           @default(now())

  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    GoodsReceiptItem[]

  @@index([supplierId, status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String   @id @default(cuid())
  goodsReceiptId String
  productId      String
  quantity       Int
  costPrice      Decimal  @db.Decimal(10, 3)
  batchNumber    String?
  expiryDate     DateTime?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

// --- Product Batch Management — tracks stock by batch, especially for food/expiry. ---

model ProductBatch {
  id                String    @id @default(cuid())
  productId         String
  supplierId        String
  batchNumber       String
  expiryDate        DateTime?
  quantity          Int // originally received
  remainingQuantity Int // decremented as this batch's stock sells/is lost — never goes below 0
  createdAt         DateTime  @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([expiryDate])
  @@map("product_batches")
}

// --- Inventory Counting — physical count vs system count reconciliation. ---

model StockCount {
  id                String   @id @default(cuid())
  productId         String
  supplierId        String
  systemQuantity    Int // what the system believed at count time
  physicalQuantity  Int // what was actually counted
  method            String   @default("MANUAL") // MANUAL | BARCODE
  countedByUserId   String
  createdAt         DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([supplierId])
  @@map("stock_counts")
}

// ---------------------------------------------------------------------------

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  percentOff    Int?
  amountOff     Decimal?  @db.Decimal(10, 3)
  minOrderValue Decimal?  @db.Decimal(10, 3)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)

  @@map("promo_codes")
}

// ---------------------------------------------------------------------------
// SAVEO PLUS — monthly membership
// ---------------------------------------------------------------------------

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// Fixed, known set of benefit "kinds" the app can actually act on (checkout
// discount, delivery waiver, badge, etc.) — NOT the plan catalog itself.
// Which plans HAVE which benefits, and whether each is on/off, lives in
// MembershipPlanBenefit below, fully admin-editable.
enum MembershipBenefitKey {
  EXTRA_DISCOUNT // extra % off every order, on top of normal Saveo pricing
  EARLY_ACCESS // see new deals/mystery boxes before non-members
  EXCLUSIVE_DEALS // can purchase Members Only products
  FREE_DELIVERY // delivery fee waived regardless of order size
  PLUS_BADGE // shows the membership badge across the site
  MYSTERY_BOX_BONUS // bonus guaranteed-value uplift on mystery boxes
  DOUBLE_REWARD_POINTS // Hook only — no reward-points system exists yet
}

// ---------------------------------------------------------------------------
// MEMBERSHIP PLAN CATALOG (Phase 4.4)
//
// Ships with one plan (Saveo Plus) but the schema supports N plans
// (Premium, Family, Business, ...) without redesign — just insert more
// MembershipPlan rows. Nothing in the app hardcodes "Saveo Plus" as the
// only plan; UserMembership always references a specific MembershipPlan.
// ---------------------------------------------------------------------------

model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  slug          String   @unique
  description   String?  @db.Text
  descriptionAr String?  @db.Text
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pricingOptions MembershipPricingOption[]
  benefits       MembershipPlanBenefit[]
  memberships    Membership[]

  @@map("membership_plans")
}

// Price + duration live here, not in code. A plan can offer both a
// MONTHLY and a YEARLY option simultaneously; admin can edit price or
// deactivate an option without touching the plan itself.
model MembershipPricingOption {
  id           String       @id @default(cuid())
  planId       String
  billingCycle BillingCycle
  price        Decimal      @db.Decimal(10, 3)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([planId, billingCycle])
  @@map("membership_pricing_options")
}

// Which benefits a plan grants, and their tunable value (e.g. 5.00 for a
// 5% EXTRA_DISCOUNT). Admin can flip `isEnabled` off without deleting the
// row — BenefitEngine (src/lib/services/benefit-engine.ts) only honors
// enabled rows.
model MembershipPlanBenefit {
  id        String               @id @default(cuid())
  planId    String
  key       MembershipBenefitKey
  isEnabled Boolean              @default(true)
  value     Decimal?             @db.Decimal(10, 3) // meaning depends on `key` (e.g. % for EXTRA_DISCOUNT)
  label     String?
  labelAr   String?

  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("membership_plan_benefits")
}

model Membership {
  id              String           @id @default(cuid())
  userId          String           @unique
  planId          String
  pricingOptionId String
  status          MembershipStatus @default(ACTIVE)
  startsAt        DateTime         @default(now())
  endsAt          DateTime // next billing / expiry date; renewed by a scheduled job
  autoRenew       Boolean          @default(true)
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan          @relation(fields: [planId], references: [id])
  pricingOption MembershipPricingOption @relation(fields: [pricingOptionId], references: [id])

  @@map("memberships")
}

// ---------------------------------------------------------------------------
// DEAL OF THE HOUR — a single rotating spotlight slot with social proof
// ---------------------------------------------------------------------------

model DealOfTheHour {
  id               String   @id @default(cuid())
  productId        String
  startTime        DateTime
  endTime          DateTime
  discountOverride Int? // optional % that overrides the product's normal discount for this slot
  stockLimit       Int // e.g. "Only 8 left" — independent of the product's real stock
  buyersCount      Int      @default(0) // increments on each purchase during the slot, for social proof
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([startTime, endTime])
  @@map("deal_of_the_hour")
}

// ---------------------------------------------------------------------------
// COMPETITOR PRICING (Phase 7.3 follow-up)
//
// Manually entered by an admin — no automated scraping/API integration
// (deliberately: scraping is legally risky per-site, and no reliable
// Kuwait/GCC price-comparison API exists). When a real, recent
// CompetitorPrice exists for a product, PricingEngineService uses it
// INSTEAD OF the category-average proxy — a genuine upgrade in accuracy
// whenever real data has been entered.
// ---------------------------------------------------------------------------

model CompetitorPrice {
  id              String   @id @default(cuid())
  productId       String
  competitorName  String
  price           Decimal  @db.Decimal(10, 3)
  updatedByUserId String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, competitorName])
  @@index([productId])
  @@map("competitor_prices")
}

// ---------------------------------------------------------------------------
// WAREHOUSE ERP (Phase 7.4)
//
// CRITICAL INVARIANT — "no duplicated stock logic": Product.stockQty
// (set by the existing setStockQuantity/reserveStock/recordDamage in
// src/lib/inventory.ts) remains the ONE source of truth for how much
// stock exists. ProductLocationStock never independently tracks a
// competing quantity — it's a DECOMPOSITION of that same number across
// physical locations. The invariant Σ(ProductLocationStock.quantity for
// a product) ≤ Product.stockQty is enforced by WarehouseService; the
// difference is "received but not yet put away" stock. Transfers move
// quantity between locations with zero net change to Product.stockQty.
// Picking calls the EXISTING releaseReservedStock/setStockQuantity
// functions to actually reduce stock — never a parallel decrement.
// ---------------------------------------------------------------------------

model WarehouseLocation {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "A-01-03" (zone-aisle-shelf)
  zone      String
  aisle     String?
  shelf     String?
  bin       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stock          ProductLocationStock[]
  transfersFrom  StockTransfer[]        @relation("TransferFrom")
  transfersTo    StockTransfer[]        @relation("TransferTo")
  pickListItems  PickListItem[]

  @@map("warehouse_locations")
}

// Decomposition of Product.stockQty across physical locations — see the invariant note above. Never an independent quantity source.
model ProductLocationStock {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("product_location_stock")
}

model StockTransfer {
  id             String   @id @default(cuid())
  productId      String
  fromLocationId String
  toLocationId   String
  quantity       Int
  note           String?
  createdByUserId String
  createdAt      DateTime @default(now())

  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocation WarehouseLocation @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   WarehouseLocation @relation("TransferTo", fields: [toLocationId], references: [id])

  @@index([productId])
  @@map("stock_transfers")
}

// --- Purchase Orders — the REQUEST to a supplier, genuinely distinct from GoodsReceipt (Phase 5.5), which records what actually arrived. A PurchaseOrder can be linked to the GoodsReceipt that fulfills it, reusing that existing receiving flow rather than duplicating it. ---

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  supplierId      String
  referenceNumber String              @unique
  status          PurchaseOrderStatus @default(DRAFT)
  expectedDate    DateTime?
  createdByUserId String
  createdAt       DateTime            @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Int
  unitCost        Decimal @db.Decimal(10, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// --- Picking & Packing — fulfillment workflow for an existing SupplierOrder. Picking a quantity here calls the existing stock-reduction functions; this model never tracks stock quantity itself, only fulfillment progress. ---

enum PickListStatus {
  PENDING
  PICKING
  PICKED
  PACKED
}

model PickList {
  id              String         @id @default(cuid())
  supplierOrderId String         @unique
  status          PickListStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  packedAt        DateTime?

  supplierOrder SupplierOrder    @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  items         PickListItem[]

  @@map("pick_lists")
}

model PickListItem {
  id         String   @id @default(cuid())
  pickListId String
  productId  String
  locationId String? // suggested pick location, if the product has been put away somewhere
  quantity   Int
  isPicked   Boolean  @default(false)

  pickList PickList           @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  location WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@index([pickListId])
  @@map("pick_list_items")
}

// ---------------------------------------------------------------------------
// MOBILE REFRESH TOKENS (Phase 7.6)
//
// The Phase 6.12 mobile access token was a single 30-day HMAC token
// with no way to revoke it early (logout, lost device, compromised
// token). This splits that into a SHORT-lived access token (see
// MobileAuthService) plus a server-stored refresh token that can
// actually be revoked. Only the SHA-256 hash of the refresh token is
// stored — never the plaintext — so a database leak alone can't be
// used to impersonate a user.
// ---------------------------------------------------------------------------

model MobileRefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mobile_refresh_tokens")
}

// ---------------------------------------------------------------------------
// MOBILE CART SYNC (Phase 7.6)
//
// The web cart is intentionally client-side-only (Zustand) — Phase
// 6.12 correctly noted no mobile cart API was needed since checkout
// already accepts a plain items array from any client. "Cart Sync"
// here is a genuinely different, real need: letting a customer's cart
// follow them across their own devices (start on phone, finish on
// tablet). One row per user; last-write-wins, which is the right
// tradeoff for a personal cart, not a source-of-truth inventory system.
// ---------------------------------------------------------------------------

model MobileCartSync {
  id        String   @id @default(cuid())
  userId    String   @unique
  itemsJson Json // [{ productId, quantity }] — the mobile client's own shape, opaque to the server
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mobile_cart_sync")
}

// ---------------------------------------------------------------------------
// SUPPLIER PERFORMANCE CENTER (Phase 7.8)
//
// Every KPI is computed from data that already exists elsewhere in
// this schema — SupplierOrderStatusHistory (acceptance/cancellation),
// Delivery (SLA), Review (rating), OrderIssue/ReturnRequest
// (complaints/returns — order-level, not per-supplier-item, so a
// multi-supplier order counts against every supplier with items in
// it; documented honestly as an approximation), StockCount
// (inventory accuracy). "Bonus visibility" hooks into the REAL
// existing DiscoveryScoreEngine (Phase 5.6) via Supplier.visibilityBoost
// rather than a second, parallel ranking system.
// ---------------------------------------------------------------------------

enum SupplierBadge {
  NONE
  RISING
  TRUSTED
  TOP_RATED
  ELITE
}

model SupplierPerformanceScore {
  id                  String        @id @default(cuid())
  supplierId          String        @unique
  acceptanceRate      Float // %
  cancellationRate    Float // %
  lateShipmentRate    Float // %
  avgRating           Float // 0-5
  returnRate          Float // %
  complaintRate       Float // %
  inventoryAccuracy   Float // %
  compositeScore      Float // 0-100
  badge               SupplierBadge @default(NONE)
  lastPenaltyReason   String?
  lastRewardReason    String?
  calculatedAt        DateTime      @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_performance_scores")
}

// ---------------------------------------------------------------------------
// PRODUCT EXPERIENCE STUDIO (Phase 8.0 — signature feature, batch 1)
//
// Deliberately does NOT touch ProductMedia/ProductMediaType (already
// supports IMAGE_360, VIDEO, THREE_D_MODEL since Phase 5.3) or
// productStory/originStory/highlightFeatures (Phase 5.6) — those are
// reused as-is by the 360° Viewer and Video Commerce experiences,
// which were missing a DISPLAY component, not data. Only genuinely
// new structures are added here: Ingredient Explorer, Nutrition
// Experience, and a real multi-badge system (experienceType was a
// single classification, not a set of earned/assigned badges).
// ---------------------------------------------------------------------------

model ProductIngredient {
  id           String  @id @default(cuid())
  productId    String
  name         String
  nameAr       String?
  origin       String?
  benefit      String? @db.Text
  isAllergen   Boolean @default(false)
  certificateUrl String?
  sortOrder    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_ingredients")
}

model ProductNutritionFact {
  id              String  @id @default(cuid())
  productId       String  @unique
  servingSize     String? // e.g. "30g"
  calories        Float?
  proteinG        Float?
  carbsG          Float?
  sugarG          Float?
  fatG            Float?
  saturatedFatG   Float?
  fiberG          Float?
  sodiumMg        Float?
  dietTags        String[] // e.g. ["VEGAN", "KETO_FRIENDLY", "GLUTEN_FREE"] — admin/supplier-entered, not auto-inferred

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_nutrition_facts")
}

enum ProductBadgeType {
  TRENDING
  LIMITED
  EXCLUSIVE
  SAVEO_PLUS
  AWARD_WINNER
  CHEF_CHOICE
  HEALTHY_CHOICE
  KIDS_FAVORITE
  PREMIUM
  NEW_ARRIVAL
  BEST_SELLER
  EDITORS_PICK
}

model ProductBadge {
  id         String           @id @default(cuid())
  productId  String
  type       ProductBadgeType
  isAutomatic Boolean         @default(false) // true = assigned by BadgeEngine from real signals; false = manually set by admin
  assignedAt DateTime         @default(now())
  expiresAt  DateTime? // e.g. NEW_ARRIVAL naturally expires after 30 days

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type])
  @@index([productId])
  @@map("product_badges")
}

// ---------------------------------------------------------------------------
// STORY MODE TIMELINE (Phase 8.0 batch 2)
//
// productStory/originStory/highlightFeatures (Phase 5.6) remain as the
// short intro text shown at the top of ProductStorySection — untouched,
// not duplicated. This adds the genuinely missing piece: an ORDERED
// SEQUENCE of steps (origin -> manufacturing -> quality -> certificates
// -> awards) for real scrollable storytelling, which a single text
// field can't represent.
// ---------------------------------------------------------------------------

enum StoryStepType {
  ORIGIN
  MANUFACTURING
  INGREDIENTS
  QUALITY
  CERTIFICATE
  AWARD
  CUSTOM
}

model ProductStoryStep {
  id        String        @id @default(cuid())
  productId String
  stepType  StoryStepType
  title     String
  titleAr   String?
  content   String        @db.Text
  contentAr String?       @db.Text
  imageUrl  String?
  sortOrder Int           @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_story_steps")
}

// ---------------------------------------------------------------------------
// GIFT SYSTEM (Phase 8.2)
//
// Order gets real gift fields (message, wrap, scheduled delivery) —
// genuinely new, nothing to reuse. GiftCard is a real prepaid balance
// instrument, redeemable at checkout via the existing PromoCode-style
// discount mechanism is NOT reused (a gift card is a balance, not a
// percentage/amount-off rule) — it gets its own real redemption flow
// that reduces Order.total directly, tracked so partial use across
// multiple orders is possible.
// ---------------------------------------------------------------------------

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCard {
  id                String         @id @default(cuid())
  code              String         @unique
  initialValue      Decimal        @db.Decimal(10, 3)
  remainingBalance  Decimal        @db.Decimal(10, 3)
  purchasedByUserId String
  recipientEmail    String?
  recipientName     String?
  personalMessage   String?        @db.Text
  status            GiftCardStatus @default(ACTIVE)
  expiresAt         DateTime
  createdAt         DateTime       @default(now())

  purchasedBy  User                 @relation(fields: [purchasedByUserId], references: [id], onDelete: Cascade)
  redemptions  GiftCardRedemption[]

  @@index([purchasedByUserId])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id           String   @id @default(cuid())
  giftCardId   String
  orderId      String
  amountUsed   Decimal  @db.Decimal(10, 3)
  createdAt    DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@index([orderId])
  @@map("gift_card_redemptions")
}

// ---------------------------------------------------------------------------
// FLAVOR JOURNEY (Phase 8.0 batch 3)
//
// A structured taste profile — genuinely new, no counterpart in the
// existing schema. Intensity scores (0-5) are admin/supplier-entered
// real sensory data, not inferred or randomized. "Journey" notes
// (first taste / mid / finish) are optional short text, the same
// convention used in professional tasting notes.
// ---------------------------------------------------------------------------

model ProductFlavorProfile {
  id             String  @id @default(cuid())
  productId      String  @unique
  sweetness      Int?    // 0-5
  sourness       Int?    // 0-5
  bitterness     Int?    // 0-5
  saltiness      Int?    // 0-5
  spiciness      Int?    // 0-5
  richness       Int?    // 0-5 (creaminess/fattiness)
  firstTasteNote String? // e.g. "Bright citrus opens the palate"
  midTasteNote   String?
  finishNote     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_flavor_profiles")
}

// ---------------------------------------------------------------------------
// AI SHOPPING ASSISTANT (Phase 9.0)
//
// No LLM is connected here (same honest architecture as the admin
// assistant — AICommerceAssistantService) — this is real pattern-based
// intent extraction (price constraints, dietary/category keywords,
// bilingual) over real product/category/nutrition data already in
// this schema. Conversation history is real (persisted), not a
// client-only illusion.
// ---------------------------------------------------------------------------

model AssistantConversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId])
  @@map("assistant_conversations")
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

model AssistantMessage {
  id                String                @id @default(cuid())
  conversationId    String
  role              AssistantMessageRole
  content           String                @db.Text
  matchedProductIds Json? // string[] snapshot of product ids shown for this message, for analytics + "add all to cart"
  createdAt         DateTime              @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("assistant_messages")
}

// ---------------------------------------------------------------------------
// INTERNAL MESSAGING (Phase 9.1)
//
// Real threads between a Customer or Supplier and Saveo (an admin who
// picks up the thread) — genuinely new, no existing model covers
// free-form two-way conversation (OrderIssue is order-scoped,
// Feedback is one-way). "Real-time" here is honest near-real-time via
// client polling, not a WebSocket/Pusher connection — no such
// infrastructure exists in this project, and pretending otherwise
// would be dishonest. Attachments follow the same URL-link convention
// already used everywhere else in this codebase (no real file-upload
// pipeline exists — see MediaManager) rather than faking one.
//
// KNOWN GAP: Driver <-> Saveo messaging is NOT included. DeliveryDriver
// has no linked User account in this schema (drivers aren't Saveo
// platform users, confirmed by the existing driver-ping endpoint's own
// comment) — real driver messaging would require building driver
// authentication first, which is out of scope here and not faked.
// ---------------------------------------------------------------------------

enum MessageThreadParticipantType {
  CUSTOMER
  SUPPLIER
}

enum MessageThreadStatus {
  OPEN
  CLOSED
}

model MessageThread {
  id                String                       @id @default(cuid())
  participantUserId String
  participantType    MessageThreadParticipantType
  subject           String
  status            MessageThreadStatus          @default(OPEN)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  participant User      @relation(fields: [participantUserId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([participantUserId])
  @@index([status])
  @@map("message_threads")
}

model Message {
  id             String    @id @default(cuid())
  threadId       String
  senderUserId   String
  content        String    @db.Text
  attachmentUrl  String?
  attachmentType String? // "IMAGE" | "DOCUMENT" — mirrors the convention used by ReviewMedia/ProductMedia
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// AFFILIATE SYSTEM (Phase 9.2)
//
// Order.promoCode already existed in the schema but had zero real
// logic behind it — this is the first real use of that field, as the
// referral code entered at checkout. Cookie attribution uses a real
// signed cookie set on ?ref=CODE visits (30-day window, standard
// affiliate cookie convention). Commission confirms only when the
// referred order is actually DELIVERED (not at placement — a
// cancelled/returned order earns nothing). Withdrawals reuse the
// exact SupplierPayout pattern (PENDING -> PAID, admin-run).
//
// MULTI-LEVEL READY, NOT ACTIVE: AffiliateAccount.referredByAffiliateId
// lets one affiliate be recruited by another — the relation exists so
// a future phase can add a second-tier commission split, but no
// second-tier commission is calculated today. Honestly incomplete,
// not faked.
// ---------------------------------------------------------------------------

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
}

enum AffiliateReferralStatus {
  PENDING // order placed, not yet delivered — commission not confirmed
  CONFIRMED // order delivered — commission is real and withdrawable
  CANCELLED // order cancelled/returned — commission voided
}

enum AffiliateWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

model AffiliateAccount {
  id                    String          @id @default(cuid())
  userId                String          @unique
  referralCode          String          @unique
  commissionRate        Float           @default(2) // percent of order subtotal — admin-adjustable per affiliate
  status                AffiliateStatus @default(ACTIVE)
  totalEarned           Decimal         @default(0) @db.Decimal(10, 3) // sum of CONFIRMED referrals, ever
  totalWithdrawn        Decimal         @default(0) @db.Decimal(10, 3)
  referredByAffiliateId String? // multi-level-ready, see note above — not used for commission math yet
  createdAt             DateTime        @default(now())

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referredByAffiliate AffiliateAccount?   @relation("AffiliateRecruits", fields: [referredByAffiliateId], references: [id])
  recruits          AffiliateAccount[]    @relation("AffiliateRecruits")
  clicks            AffiliateClick[]
  referrals         AffiliateReferral[]
  withdrawals       AffiliateWithdrawal[]
  milestones        AffiliateMilestone[]

  @@map("affiliate_accounts")
}

model AffiliateClick {
  id           String   @id @default(cuid())
  affiliateId  String
  referrerUrl  String?
  landingPath  String
  createdAt    DateTime @default(now())

  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("affiliate_clicks")
}

model AffiliateReferral {
  id                String                   @id @default(cuid())
  affiliateId       String
  orderId           String                   @unique // one order attributed to exactly one affiliate
  orderSubtotal     Decimal                  @db.Decimal(10, 3) // snapshotted at confirmation time
  commissionAmount  Decimal                  @db.Decimal(10, 3) // snapshotted using the rate at confirmation time
  status            AffiliateReferralStatus  @default(PENDING)
  confirmedAt       DateTime?
  createdAt         DateTime                 @default(now())

  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([affiliateId, status])
  @@map("affiliate_referrals")
}

model AffiliateWithdrawal {
  id              String                     @id @default(cuid())
  affiliateId     String
  amount          Decimal                    @db.Decimal(10, 3)
  status          AffiliateWithdrawalStatus  @default(PENDING)
  referenceNumber String?                    @unique
  rejectionReason String?
  paidAt          DateTime?
  createdAt       DateTime                   @default(now())

  affiliate AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_withdrawals")
}

// ---------------------------------------------------------------------------
// AFFILIATE MILESTONES (Phase 9.3)
//
// Real, automatic tiered rewards — checked after every confirmed
// referral. Each milestone type can only be awarded once per
// affiliate (enforced by the unique constraint below), so a retry or
// re-check never double-issues a reward. Gift cards issued here reuse
// the real GiftCard model (Phase 8.2) — not a separate fake currency.
// ---------------------------------------------------------------------------

enum AffiliateMilestoneMetric {
  REFERRAL_COUNT // confirmed referral count
  REVENUE // confirmed referred revenue, KD
}

// Admin-editable milestone definitions — replaces the old fixed
// 3-tier enum. Admins can add, edit, or deactivate any milestone
// freely from /admin/affiliates. isActive (not deletion) is used to
// retire a rule, so historical AffiliateMilestone awards under it
// stay intact and explainable.
model AffiliateMilestoneRule {
  id                String                   @id @default(cuid())
  name              String // e.g. "15 Referrals" — admin-entered, shown to affiliates
  metric            AffiliateMilestoneMetric
  threshold         Float // referral count, or KD revenue, depending on metric
  giftCardAmount    Decimal                  @default(0) @db.Decimal(10, 3)
  newCommissionRate Float? // optional — null means this rule never touches the rate
  isActive          Boolean                  @default(true)
  sortOrder         Int                      @default(0)
  createdAt         DateTime                 @default(now())

  awards AffiliateMilestone[]

  @@map("affiliate_milestone_rules")
}

model AffiliateMilestone {
  id          String   @id @default(cuid())
  affiliateId String
  ruleId      String
  giftCardId  String? // the real GiftCard issued as the reward, if any
  awardedAt   DateTime @default(now())

  affiliate AffiliateAccount       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  rule      AffiliateMilestoneRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, ruleId])
  @@map("affiliate_milestones")
}

// ---------------------------------------------------------------------------
// COLLECTIONS (Discovery Methods, batch 1)
//
// Real admin-curated groupings of products — genuinely new, no
// existing model covers "hand-picked selection with explicit order"
// (Category is structural/taxonomic, Bundle is a priced package deal
// with its own checkout logic). CollectionProduct is an explicit join
// table (not an implicit many-to-many) specifically so sortOrder is
// real and admin-controlled — the curation itself is the point.
// ---------------------------------------------------------------------------

model Collection {
  id             String   @id @default(cuid())
  name           String
  nameAr         String?
  slug           String   @unique
  description    String?  @db.Text
  descriptionAr  String?  @db.Text
  coverImageUrl  String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@map("collection_products")
}

// --- Discover — Quick Ways In (admin-managed shortcuts) ---
// Additive, standalone model — zero relation to existing models, zero
// modification to anything above. destinationKey is validated against
// a closed, code-defined list (see src/lib/quick-way-destinations.ts),
// never a free-form URL.
model QuickWayShortcut {
  id             String   @id @default(cuid())
  destinationKey String
  labelEn        String
  labelAr        String
  icon           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("quick_way_shortcuts")
}
