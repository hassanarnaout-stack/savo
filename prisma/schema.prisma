// --- Tracking System (§14) — NOT the same as MarketingCampaignEvent; scoped to BrandAccount/BrandMarketingCampaign. ---

enum BrandEventType {
  IMPRESSION
  CLICK
  PRODUCT_VIEW
  ADD_TO_CART
  PURCHASE
}

model BrandEvent {
  id         String         @id @default(cuid())
  brandId    String
  campaignId String?
  userId     String?
  eventType  BrandEventType
  metadata   Json?
  billedAmount Decimal?     @default(0) @db.Decimal(6, 4) // Phase 7.7 — what this event actually cost the brand, 0 if unbilled/flagged
  isFlaggedFraud Boolean    @default(false) // Phase 7.7 — set by SponsoredBillingService's fraud check; flagged events are recorded but never billed
  createdAt  DateTime       @default(now())

  brand    BrandAccount            @relation(fields: [brandId], references: [id], onDelete: Cascade)
