// --- AI Brand Assistant (§11) — architecture only, no real AI API call.
// getSuggestions() below returns rule-based placeholders describing what
// a future AI integration would analyze and recommend; see the service
// file for the exact scope boundary. No dedicated model needed yet. ---

// --- Billing System (§12) ---

enum BrandInvoiceType {
  SPONSORED_PRODUCT
  CAMPAIGN
  SUBSCRIPTION
  TAKEOVER
  MYSTERY_BOX_SPONSOR
}

enum BrandInvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model BrandInvoice {
  id        String             @id @default(cuid())
  brandId   String
  type      BrandInvoiceType
  amount    Decimal            @db.Decimal(10, 3)
  status    BrandInvoiceStatus @default(PENDING)
